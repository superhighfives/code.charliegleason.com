    "@types/mdast": "^4.0.4",
    "@types/node": "24.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-mdx": "^3.0.0",
    "playwright": "^1.49.1",
    "tailwindcss": "4.2.2",
    "tldraw": "^5.1.1",
    "tsx": "^4.22.4",
    "typescript": "5.8.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "4.101.0"
  },
  "scripts": {
    "build": "react-router build",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "typegen": "wrangler types && react-router typegen",
    "check": "tsc && react-router build && wrangler deploy --dry-run",
    "deploy": "pnpm build && pnpm upload:assets:production && pnpm clean:videos:build && wrangler deploy",
    "deploy:staging": "pnpm build:staging && pnpm upload:assets:staging && pnpm clean:videos:build && wrangler deploy",
    "dev": "react-router dev",
    "dev:staging": "CLOUDFLARE_ENV=staging react-router dev",
    "preview": "pnpm build && vite preview",
    "typecheck": "pnpm typegen && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "mermaid:render": "tsx scripts/render-mermaid.ts",
    "mermaid:clean": "tsx scripts/render-mermaid.ts --clean",
    "generate:images": "tsx scripts/generate-images.ts",
    "generate:videos": "tsx scripts/generate-videos.ts",
    "generate:colors": "tsx scripts/generate-colors.ts",
    "validate:images": "tsx scripts/validate-images.ts",
    "delete:invalid-images": "tsx scripts/delete-invalid-images.ts",
    "upload:assets:production": "./scripts/upload-assets.sh",
    "upload:assets:staging": "CLOUDFLARE_ENV=staging ./scripts/upload-assets.sh",
    "clean:videos:build": "find build/client/posts -name '*.mp4' -delete 2>/dev/null || true",
    "fix:image-profiles": "tsx scripts/fix-image-profiles.ts"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}

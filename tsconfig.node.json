{
  "extends": "./tsconfig.json",
  "include": [
    "tailwind.config.ts",
    "vite.config.ts",
    "lib/mdx-plugin.ts",
    "lib/**/*",
    "scripts/render-mermaid.ts",
    "scripts/mermaid/shared.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
